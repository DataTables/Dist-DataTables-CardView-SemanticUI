{
    "name": "datatables.net-cardview-se",
    "description": "CardView for DataTables with styling for [SemanticUI](https://semantic-ui.com/)",
    "main": "./js/cardView.semanticui.js",
    "module": "./js/cardView.semanticui.mjs",
    "style": "./css/cardView.semanticui.css",
    "types": "./types/cardView.semanticui.d.ts",
    "version": "1.1.1",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Cards",
        "Responsive",
        "Semantic",
        "SemanticUI",
        "Semantic UI",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-cardview": "1.1.1",
        "datatables.net-se": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "SEE LICENSE IN License.txt",
    "exports": {
        ".": {
            "types": "./types/cardView.semanticui.d.ts",
            "style": "./css/cardView.semanticui.css",
            "import": "./js/cardView.semanticui.mjs",
            "require": "./js/cardView.semanticui.js",
            "default": "./js/cardView.semanticui.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/cardView.semanticui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}